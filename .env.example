# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm db:start` (supabase status).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Added in later milestones
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Optional. Without a key, maintenance triage uses keyword rules only.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
# Optional. Without a key, notifications stay in-app only.
RESEND_API_KEY=your-resend-api-key
# Optional. Defaults to Resend's shared sender, which only delivers to your own
# Resend account address until you verify a domain.
EMAIL_FROM=
# Optional. Base URL for links in emails. On Vercel it defaults to the production domain.
SITE_URL=
