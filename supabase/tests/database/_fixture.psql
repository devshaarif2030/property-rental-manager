-- Shared RLS test fixture. Included by each test file with \ir, inside the
-- test's transaction, so everything here is rolled back after the file runs.
--
-- Two organizations:
--   Org A: admin_a, manager_a, tenant_a1, tenant_a2, staff_a1, staff_a2
--   Org B: manager_b, tenant_b
-- Each tenant has one unit, one active lease, one rent charge and one payment.
-- Each tenant has one maintenance request; A's requests are assigned to staff_a1
-- and staff_a2 respectively. Every request has one photo and one update.
--
-- UUIDs are fixed so assertions can name rows. The second group of the UUID
-- encodes the kind of row: 0001 org, 0002 user, 0003 property, 0004 unit,
-- 0005 lease, 0006 charge, 0007 payment, 0008 request, 0009 photo, 0010 update,
-- 0011 notification, 0012 invite, 0013 lease file, 0014 photo file.

create schema tests;
grant usage on schema tests to anon, authenticated;

create function tests.authenticate_as(user_id uuid)
returns void
language sql
as $$
  select set_config('request.jwt.claims', json_build_object('sub', user_id, 'role', 'authenticated')::text, true);
  select set_config('role', 'authenticated', true);
$$;

create function tests.authenticate_as_anon()
returns void
language sql
as $$
  select set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  select set_config('role', 'anon', true);
$$;

create function tests.clear_authentication()
returns void
language sql
as $$
  select set_config('role', 'postgres', true);
  select set_config('request.jwt.claims', '', true);
$$;

grant execute on all functions in schema tests to anon, authenticated;

